# Optional. Micro Manager is configured from its own Settings page, so most
# installs need none of this. Copy to .env only to override something.

# PORT=3000
# DATA_DIR=./data
# MAX_UPLOAD_MB=200

# Public address, if the one detected during setup is wrong
# APP_URL=https://studio.example.com

# Create the first admin on boot instead of using the setup screen
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me-please

# Override the Stripe settings saved in the app
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# CURRENCY=usd

# Testing only: without Stripe, lets clients simulate paying their own invoices
# DEMO_PAYMENTS=true
