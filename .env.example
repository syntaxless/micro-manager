# Port the server listens on
PORT=3000
# Public URL of this install (used for invite links and Stripe redirects)
APP_URL=http://localhost:3000
# Where the SQLite database and uploaded files live
DATA_DIR=./data
# Max upload size in megabytes
MAX_UPLOAD_MB=200

# Optional: create the first admin automatically on boot (otherwise use the /setup screen)
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me-please

# Stripe (use test-mode keys: sk_test_..., whsec_...)
# Leave blank to run in demo mode, where clients can simulate payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Without Stripe, let clients simulate payments so you can try the file-unlock flow.
# Testing only: anyone with a client login could mark their own invoices paid.
DEMO_PAYMENTS=true
# Default currency for invoices and subscriptions
CURRENCY=usd
